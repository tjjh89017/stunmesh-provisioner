#!/bin/sh /etc/rc.common
# stunmesh-agent.init -- procd service for stunmesh-agent (daemon mode).
#
# stunmesh-agent is a long-running daemon (README.md, CLAUDE.md): it
# fetches, decrypts, checks, and applies once at start, then ticks on
# its own refresh_interval and full_apply_interval (both read from
# config.yaml). This script's only job is to (re)generate
# /etc/stunmesh/agent/config.yaml from UCI, then hand the process to
# procd as a supervised, respawned instance.
#
# stunmesh-agent has no SIGHUP handler, so `/etc/init.d/stunmesh-agent
# reload` regenerates config.yaml and restarts the process outright.

START=95
STOP=10
USE_PROCD=1

UCI_PACKAGE="stunmesh-agent"
UCI_SECTION="main"
BIN="/usr/sbin/stunmesh-agent"
CONFIG_DIR="/etc/stunmesh/agent"
CONFIG_FILE="$CONFIG_DIR/config.yaml"

. /lib/functions.sh

# log writes one line to the system log, tagged so it is easy to find
# with "logread | grep stunmesh-agent". It never receives a value that
# could be a secret: every caller passes fixed text only.
log() {
	logger -t stunmesh-agent "$1"
}

# yaml_quote renders one scalar for use inside a YAML double-quoted
# string ("..."), escaping backslash and double-quote (the two
# characters double-quoted YAML style itself treats specially). Every
# value this script writes into config.yaml -- namespace, node_id,
# controller_pubkey, a proxy URL, a path -- goes through this, so a
# value containing ":", "#", or any other YAML-significant character
# is always safe inside the quotes it is wrapped in, and never
# reinterpreted as YAML syntax.
yaml_quote() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# yaml_scalar prints "key: \"value\"" for one config.yaml top-level
# key, only when value is non-empty: every optional key this script
# can emit falls back to stunmesh-agent's own default when it is
# simply absent from config.yaml (config.go's buildConfig), so an
# empty UCI option is rendered as "omit the key", never as an empty
# string value.
yaml_scalar() {
	local key="$1" value="$2"
	[ -n "$value" ] || return 0
	printf '%s: "%s"\n' "$key" "$(yaml_quote "$value")"
}

# write_plugin_entry renders one "stunmesh-agent-plugin" UCI section
# (identified by uci_name, its own section name -- UCI named sections
# use the given name as the section id, so this is exactly the name a
# "main" section's use_plugin option must reference) as one entry of
# config.yaml's "plugins" map. Only "type" and "proxies" exist today
# (docs/format.md section 3); "list proxies" is the only accepted list
# name.
write_plugin_entry() {
	local uci_name="$1"
	local type proxies
	config_get type "$uci_name" type
	config_get proxies "$uci_name" proxies

	printf '  "%s":\n' "$(yaml_quote "$uci_name")"
	printf '    type: "%s"\n' "$(yaml_quote "$type")"
	if [ -n "$proxies" ]; then
		printf '    proxies:\n'
		local p
		for p in $proxies; do
			printf '      - "%s"\n' "$(yaml_quote "$p")"
		done
	fi
}

# write_config reads /etc/config/stunmesh-agent's "main" section (plus
# every "stunmesh-agent-plugin" section, when "main" names one with
# use_plugin) and writes config.yaml (mode 0600). It returns 1 (and
# leaves any existing config.yaml untouched) when the file is absent
# or "main" is missing a required option -- "not provisioned yet", not
# an error; start_service treats that as "do not start" (see below).
write_config() {
	config_load "$UCI_PACKAGE" || {
		log "no /etc/config/$UCI_PACKAGE; skipping"
		return 1
	}

	local namespace node_id controller_pubkey use_plugin
	local refresh_interval full_apply_interval
	local identity_key last lock
	config_get namespace "$UCI_SECTION" namespace
	config_get node_id "$UCI_SECTION" node_id
	config_get controller_pubkey "$UCI_SECTION" controller_pubkey
	config_get use_plugin "$UCI_SECTION" use_plugin
	config_get refresh_interval "$UCI_SECTION" refresh_interval
	config_get full_apply_interval "$UCI_SECTION" full_apply_interval
	config_get identity_key "$UCI_SECTION" identity_key
	config_get last "$UCI_SECTION" last
	config_get lock "$UCI_SECTION" lock

	if [ -z "$namespace" ] || [ -z "$node_id" ] || [ -z "$controller_pubkey" ]; then
		log "incomplete /etc/config/$UCI_PACKAGE (need namespace, node_id, controller_pubkey); skipping"
		return 1
	fi

	mkdir -p "$CONFIG_DIR" || {
		log "could not create $CONFIG_DIR"
		return 1
	}

	local tmp
	tmp="$(mktemp "$CONFIG_FILE.XXXXXX")" || {
		log "mktemp failed while rendering config.yaml"
		return 1
	}

	if ! {
		yaml_scalar namespace "$namespace"
		yaml_scalar node_id "$node_id"
		yaml_scalar controller_pubkey "$controller_pubkey"
		yaml_scalar refresh_interval "$refresh_interval"
		yaml_scalar full_apply_interval "$full_apply_interval"
		yaml_scalar identity_key "$identity_key"
		yaml_scalar last "$last"
		yaml_scalar lock "$lock"

		if [ -n "$use_plugin" ]; then
			yaml_scalar use_plugin "$use_plugin"
			printf 'plugins:\n'
			write_plugin_entry "$use_plugin"
		fi
	} >"$tmp"; then
		rm -f "$tmp"
		log "failed to render config.yaml"
		return 1
	fi

	chmod 0600 "$tmp"
	if ! mv "$tmp" "$CONFIG_FILE"; then
		rm -f "$tmp"
		log "failed to install config.yaml"
		return 1
	fi
	return 0
}

start_service() {
	write_config || return 0

	procd_open_instance
	procd_set_param command "$BIN" --config-dir "$CONFIG_DIR"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Go reads TZ, not /etc/TZ. A POSIX TZ string needs no tzdata.
	procd_set_param env TZ="$(cat /etc/TZ 2>/dev/null)"
	procd_close_instance
}

stop_service() {
	:
}

service_triggers() {
	procd_add_reload_trigger "$UCI_PACKAGE"
}

# reload_service regenerates config.yaml from the (possibly just
# edited) UCI state, then restarts the daemon outright -- see the
# "No reload_signal" note above for why a restart, not a signal, is
# the reload here.
reload_service() {
	write_config
	restart
}
