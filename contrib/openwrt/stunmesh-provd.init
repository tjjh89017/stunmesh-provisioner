#!/bin/sh /etc/rc.common
# stunmesh-provd.init -- procd service for stunmesh-provd, the
# controller (see contrib/openwrt/README.md). Optional: the normal way
# to run the controller is contrib/systemd/stunmesh-provd.service on a
# regular Linux host, not an OpenWrt router. Running it here costs
# flash wear (the state tree under /etc/stunmesh/provd) and puts a
# secrets-holding daemon on the device it provisions -- an operator's
# call, not this script's.
#
# Nothing here calls "enable"; a downstream package must do that
# explicitly. Won't start until "dir" is provisioned (stunmesh-provd
# init / node add):
#   /etc/init.d/stunmesh-provd enable
#   /etc/init.d/stunmesh-provd start

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/stunmesh-provd
UCI_PACKAGE="stunmesh-provd"
UCI_SECTION="main"

. /lib/functions.sh

start_service() {
	local dir namespace

	config_load "$UCI_PACKAGE" || {
		echo "stunmesh-provd: no /etc/config/$UCI_PACKAGE, not starting" >&2
		return 1
	}
	config_get dir "$UCI_SECTION" dir "/etc/stunmesh/provd"
	config_get namespace "$UCI_SECTION" namespace ""

	[ -n "$dir" ] || dir="/etc/stunmesh/provd"

	if [ ! -d "$dir" ]; then
		echo "stunmesh-provd: $dir does not exist -- run 'stunmesh-provd --dir $dir init <namespace>' first" >&2
		return 1
	fi

	procd_open_instance
	if [ -n "$namespace" ]; then
		procd_set_param command "$PROG" --dir "$dir" publish --namespace "$namespace"
	else
		procd_set_param command "$PROG" --dir "$dir" publish
	fi
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Go reads TZ, not /etc/TZ. A POSIX TZ string needs no tzdata.
	procd_set_param env TZ="$(cat /etc/TZ 2>/dev/null)"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$UCI_PACKAGE"
}
