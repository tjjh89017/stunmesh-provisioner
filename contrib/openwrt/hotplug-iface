#!/bin/sh
# hotplug-iface -- restarts stunmesh-agent when the WAN interface comes up.
#
# OpenWrt runs every /etc/hotplug.d/iface/* script for every interface
# hotplug event on the box: every ifup, ifdown, and ifupdate, for every
# configured interface, not only WAN. Reacting to all of them would
# restart the daemon far more often than needed. This script reacts to
# exactly one case:
#
#   ACTION=ifup on the logical interface named "wan"
#
# Every other ACTION (ifdown, ifupdate) is ignored. Every other
# interface is ignored, including "wan6": stunmesh-agent talks to the
# dhtproxy over whichever address family is available once "wan"
# itself is up, so a separate "wan6" trigger is not needed. See
# README.md if a deployment's WAN interface has a different logical
# name; it must be added here.
#
# # Why a restart, not a signal
#
# stunmesh-agent has no SIGHUP handler (README.md, daemon.go's doc
# comment on runDaemon): the daemon already runs one fetch/apply cycle
# immediately at startup, so restarting it is exactly "trigger an
# immediate cycle now that WAN is up" -- the same effect a signal would
# have had, through the one reload mechanism the daemon actually
# has. `/etc/init.d/stunmesh-agent restart` is also what
# stunmesh-agent.init's own reload_service does, so this script does
# not duplicate that logic; it just calls it.
#
# # Only when the service is actually running
#
# A node with no /etc/config/stunmesh-agent yet (not provisioned), or
# with the service deliberately disabled or stopped, must not be
# restarted by a hotplug event: "running" (an rc.common command
# USE_PROCD=1 provides) reports 0 only when procd already has a
# supervised instance for this service, so a stopped or never-started
# service is left alone here, exactly like the old lock-based
# not-provisioned-yet check used to leave it alone.

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wan" ] || exit 0

INIT="/etc/init.d/stunmesh-agent"

[ -x "$INIT" ] || exit 0

if "$INIT" running >/dev/null 2>&1; then
	logger -t stunmesh-agent "wan up: restarting stunmesh-agent for an immediate fetch/apply cycle"
	"$INIT" restart >/dev/null 2>&1
fi

exit 0
