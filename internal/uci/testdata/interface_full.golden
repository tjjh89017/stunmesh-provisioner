uci set network.wg0=interface
uci set network.wg0.proto=wireguard
uci set network.wg0.private_key=wg0-private-key
uci set network.wg0.listen_port=51820
uci add_list network.wg0.addresses=10.0.0.1/24
uci add_list network.wg0.addresses=fd00::1/64
uci set network.wg0.mtu=1420
uci set network.wg0.defaultroute=0
uci set network.wg0.multipath=off
uci set network.wg0_r_0=route
uci set network.wg0_r_0.interface=wg0
uci set network.wg0_r_0.target=10.20.0.0/16
uci set network.wg0_r_0.gateway=10.0.0.2
uci set network.wg0_r_0.metric=100
uci set network.wg0_r_1=route6
uci set network.wg0_r_1.interface=wg0
uci set network.wg0_r_1.target=fd00:20::/32
uci set network.wg0_p_bravo=wireguard_wg0
uci set network.wg0_p_bravo.description=bravo
uci set network.wg0_p_bravo.public_key=bravo-public-key
uci set network.wg0_p_bravo.preshared_key=bravo-preshared-key
uci add_list network.wg0_p_bravo.allowed_ips=10.0.0.2/32
uci set network.wg0_p_bravo.endpoint_host=bravo.example.com
uci set network.wg0_p_bravo.endpoint_port=51820
uci set network.wg0_p_bravo.persistent_keepalive=25
uci set network.wg0_p_bravo.route_allowed_ips=1
uci set network.wg0_p_bravo.note=primary
uci set network.wg0_p_charlie=wireguard_wg0
uci set network.wg0_p_charlie.description=charlie
uci set network.wg0_p_charlie.public_key=charlie-public-key
uci set network.wg0_p_charlie.preshared_key=charlie-preshared-key
uci add_list network.wg0_p_charlie.allowed_ips=10.0.0.3/32
uci add_list network.wg0_p_charlie.allowed_ips=fd00::3/128
uci set network.wg0_p_charlie.endpoint_host=fd00::10
uci set network.wg0_p_charlie.endpoint_port=51821
uci set network.wg0_p_charlie.route_allowed_ips=1
