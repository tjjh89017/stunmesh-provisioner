uci set network.wg0.mtu=1420
uci set network.wg0.fwmark=0xca6c
uci set network.wg0_p_bravo=wireguard_wg0
uci set network.wg0_p_bravo.description=bravo
uci set network.wg0_p_bravo.public_key=bravo-public-key
uci add_list network.wg0_p_bravo.allowed_ips=10.0.0.2/32
uci set network.wg0_p_bravo.route_allowed_ips=1
