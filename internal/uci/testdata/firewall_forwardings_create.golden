uci set firewall.stunmesh_fwd_stunmesh_lan.dest=lan
uci set firewall.stunmesh_fwd_stunmesh_wan=forwarding
uci set firewall.stunmesh_fwd_stunmesh_wan.src=stunmesh
uci set firewall.stunmesh_fwd_stunmesh_wan.dest=wan
